                    "type": "string"
                },
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "auth.ErrResponse": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
