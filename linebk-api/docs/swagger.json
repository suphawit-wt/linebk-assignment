        "auth.SignInWithPasscodeRequest": {
            "type": "object",
            "required": [
                "id",
                "passcode"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "maxLength": 50,
                    "example": "000027b0e9a211ef95a30242ac180002"
                },
                "passcode": {
                    "type": "string",
                    "example": "123456"
                }
            }
        },
        "auth.SignInWithPasswordRequest": {
            "type": "object",
            "required": [
                "id",
                "password"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "maxLength": 50,
                    "example": "000027b0e9a211ef95a30242ac180002"
                },
                "password": {
                    "type": "string",
                    "example": "123456Az@"
                }
            }
        },
        "auth.TokenResponse": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "type": "string"
                }
            }
        },
        "transaction.ApiResponse": {
            "type": "object",
